{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline Events Evidence Model",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "metadata",
    "events"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "subtitle",
        "updated_at"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date"
        },
        "verification_state": {
          "enum": [
            "verified",
            "reference_transcription"
          ]
        },
        "notice": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "publisher",
          "title",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "date",
          "title",
          "description"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "confirmed",
              "planned"
            ]
          },
          "highlight": {
            "type": "boolean"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "period",
          "summary"
        ]
      }
    },
    "insights": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "title",
          "description"
        ]
      }
    },
    "research": {
      "type": "object",
      "description": "Optional sourced editorial dossier added after timeline board.",
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label",
              "note"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "chapters": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "title",
              "body",
              "source_ids"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "body": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "index": {
                "type": "string"
              },
              "eyebrow": {
                "type": "string"
              },
              "takeaway": {
                "type": "string"
              }
            }
          }
        },
        "connections": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "name",
              "role",
              "mechanism",
              "limits",
              "source_ids"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "mechanism": {
                "type": "string"
              },
              "limits": {
                "type": "string"
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "claim_audit": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "claim",
              "verdict",
              "finding",
              "source_ids"
            ],
            "properties": {
              "claim": {
                "type": "string"
              },
              "verdict": {
                "type": "string"
              },
              "finding": {
                "type": "string"
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "body"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            }
          }
        },
        "methodology": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
