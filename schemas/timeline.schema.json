{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline events data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "sources",
    "events"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "subtitle",
        "updated_at"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "format": "date"
        },
        "producer": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "publisher",
          "title",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "date",
          "title",
          "description",
          "source_ids"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "confirmed",
              "planned"
            ]
          },
          "highlight": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "phases": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "period",
          "summary"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "insights": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
